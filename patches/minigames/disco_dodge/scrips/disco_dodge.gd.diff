+# 8P MOD: the scene ships 4 spawn markers on the centre 2x2 tiles (+-2, +-2).
+# Tiles are 4 units wide and spawn AFTER the players, so SpawnHelper's floor
+# raycast would find nothing; instead add 4 more markers on the neighbouring
+# tile centres (+-6, +-2) so each of the 8 players starts on its own tile.
+const MOD_EXTRA_MARKERS: Array[Vector3] = [
+	Vector3(-6, 0, -2), Vector3(6, 0, -2), Vector3(6, 0, 2), Vector3(-6, 0, 2),
+]
+
+func _mod_extend_markers(count: int) -> void :
+	var n: int = player_spawn_positions_node.get_child_count()
+	var i: int = 0
+	while n < count:
+		var m := Marker3D.new()
+		m.name = "Spawn8P_%d" % n
+		player_spawn_positions_node.add_child(m)
+		m.position = MOD_EXTRA_MARKERS[i % MOD_EXTRA_MARKERS.size()] + Vector3(0, 0, 0)
+		if i >= MOD_EXTRA_MARKERS.size():
+			m.position += Vector3(0, 0, 4.0 * float(i / MOD_EXTRA_MARKERS.size())) # safety only
+		n += 1
+		i += 1
+
 func _ready() -> void :
 	super._ready()
+
+	SpawnHelper.raise_spawn_limits(self, 8) # 8P MOD: PlayerSpawner.spawn_limit = 4 in the tscn
 
 	if multiplayer.is_server():
 
