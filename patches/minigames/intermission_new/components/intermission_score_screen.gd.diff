+func expand_user_containers():
+
+	var template: Intermission_UserContainer = user_container_array[user_container_array.size() - 1]
+	var parent_node: Node = template.get_parent()
+	while user_container_array.size() < MAX_SLOTS:
+		var i := user_container_array.size()
+		var uc: Intermission_UserContainer = template.duplicate()
+		uc.name = "user info%d" % (i + 1)
+		uc.container_id = i
+		parent_node.add_child(uc)
+		user_container_array.append(uc)
+		score_container_nodes.append(uc)
+
+	var siblings: Array[Intermission_UserContainer] = []
+	for c in parent_node.get_children():
+		siblings.append(c)
+	for i in user_container_array.size():
+		var uc: Intermission_UserContainer = user_container_array[i]
+		uc.user_container_array = siblings.duplicate()
+		uc.scale = Vector3(ROW_SCALE, ROW_SCALE, ROW_SCALE)
+		uc.position.y = rank_y_positions[i]
+
 func _ready() -> void :
+	expand_user_containers()
