+
+var keyboard_rect: TextureRect
+var texture_rects: Array[TextureRect]
+var vignette_color_rects: Dictionary[KnifeAtTheOfficePlayer, ColorRect]
+
+func _process(_delta: float) -> void :
+	pass
+
+func player_infected(_player: KnifeAtTheOfficePlayer):
+
+	if vignette_color_rects.has(_player):
+		var color_rect: ColorRect = vignette_color_rects.get(_player)
+		var t = create_tween()
+		t.tween_method( func(value):
+			color_rect.set_instance_shader_parameter("radius", value), 
+			1.0, 0.8, 4.0
+		).set_trans(Tween.TRANS_BACK
+		).set_ease(Tween.EASE_IN_OUT)
+
+func set_players(players: Array[KnifeAtTheOfficePlayer]):
+
+	var vignette_material: ShaderMaterial = ShaderMaterial.new()
+	vignette_material.shader = KATO_VIGNETTE
+
+	var player_count = players.size()
+	var layout = Layouts[player_count]
+	var viewport_rect: Rect2 = local_canvas_root.get_viewport_rect()
+
+	for i in players.size():
+		var player: KnifeAtTheOfficePlayer = players[i]
+		var values = layout[i]
+
+		player.local_viewport.size = Vector2i(
+			viewport_rect.end.x * values[1].x, 
+			viewport_rect.end.y * values[1].y, 
+		)
+		var texture = player.local_viewport.get_texture()
+		var texture_rect: = TextureRect.new()
+		texture_rect.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
+		texture_rect.texture = texture
+		texture_rect.clip_children = CanvasItem.CLIP_CHILDREN_AND_DRAW
+
+		local_canvas_root.add_child(texture_rect)
+		texture_rect.position = viewport_rect.end * values[0]
+		texture_rect.size = viewport_rect.end * values[1]
+
+
+		var vignette_color_rect: ColorRect = ColorRect.new()
+
+		local_after_post_processing_root.add_child(vignette_color_rect)
+		vignette_color_rect.position = viewport_rect.end * values[0]
+		vignette_color_rect.size = viewport_rect.end * values[1]
+
+		vignette_color_rect.material = vignette_material
+		vignette_color_rect.set_instance_shader_parameter("radius", 1.0)
+		vignette_color_rect.set_instance_shader_parameter("vignette_color", Color.GREEN_YELLOW)
+
+		vignette_color_rects[player] = vignette_color_rect
