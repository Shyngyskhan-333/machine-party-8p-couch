@@ -24,6 +24,34 @@
 
 var playing: bool = false
 
+# 8P MOD: kill pace scaling (from the v2.1.2 ref). Vanilla needs 3 kills at 4 players;
+# at 8 players 7 kills would make the round ~2x longer, so fuse and dead time are scaled
+# by 3/(players-1), clamped to 1.0 (1-4 players are unchanged).
+const MOD_VANILLA_KILLS: float = 3.0
+const MOD_VANILLA_DEAD_TIME: float = 3.0
+var _mod_vanilla_fuse: float = -1.0
+
+func _mod_pace_factor() -> float:
+	return clampf(MOD_VANILLA_KILLS / float(maxi(player_count - 1, 1)), 0.0, 1.0)
+
+# 8P MOD: returns a position near base_pos that has floor beneath it and a clear
+# horizontal line from base_pos (so extra spawns do not land inside walls/props).
+func _mod_extra_spawn(base: Node3D, index: int) -> Vector3:
+	var space := base.get_world_3d().direct_space_state
+	var base_pos: Vector3 = base.global_position
+	for radius in [2.0, 1.4, 2.6, 0.9]:
+		for k in 8:
+			var angle := float(index) * PI * 0.5 + float(k) * PI * 0.25
+			var cand: Vector3 = base_pos + Vector3(sin(angle) * radius, 0.0, cos(angle) * radius)
+			var floor_q := PhysicsRayQueryParameters3D.create(cand + Vector3.UP * 3.0, cand + Vector3.DOWN * 6.0)
+			if space.intersect_ray(floor_q).is_empty():
+				continue
+			var wall_q := PhysicsRayQueryParameters3D.create(base_pos + Vector3.UP * 0.8, cand + Vector3.UP * 0.8)
+			if not space.intersect_ray(wall_q).is_empty():
+				continue
+			return cand
+	return base_pos
+
 func _ready() -> void :
 	super._ready()
 
