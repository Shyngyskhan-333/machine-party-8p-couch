+		environment.add_child(chair)
+		chair.position += FRONT_ROW_SHIFT
+
+		var controls: LocalLobbyPlayerControls = CONTROLS_SCENE.instantiate()
+		controls.name = "LocalPlayerLobbyControls%d" % (seat + 1)
