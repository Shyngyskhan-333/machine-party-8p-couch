+
+# 8P MOD: duplicate the four stations rotated 45 degrees so seats 5-8 have desks.
+func _mod_add_stations() -> void:
+	for path in MOD_STATION_NODES:
+		var node := get_node_or_null(path)
+		if node is Node3D:
+			var copy: Node3D = node.duplicate()
+			copy.name = node.name + "_MOD"
+			node.get_parent().add_child(copy)
+			copy.rotate_y(deg_to_rad(45.0))
+	for path in MOD_HIDE_PROPS:
+		var prop := get_node_or_null(path)
+		if prop:
+			prop.visible = false
+			for body in prop.find_children("*", "CollisionObject3D", true, false):
+				body.process_mode = Node.PROCESS_MODE_DISABLED
